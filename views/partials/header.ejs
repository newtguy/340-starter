<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>

  <div id="tools">
    <% if (locals.loggedin) { %>
      <!-- Welcome message (left of links) -->
      <a class="welcome" href="/account">
        Welcome <%= accountData.account_firstname %>
      </a>

      <% if (locals.loggedin) { %>
        <a href="/account/recent">Recently Viewed</a>
      <% } %>
     
      <!-- Logout link -->
      <a title="Click to log out" href="/account/logout">
        Logout
      </a>

    <% } else { %>
      <!-- Only show when NOT logged in -->
      <a title="Click to log in" href="/account/login">
        My Account
      </a>
    <% } %>
  </div>
</header>